PORT=5000
NODE_ENV=development

# Database connection string (e.g. Neon PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Shared JWT secret
JWT_SECRET="your-super-secret-jwt-key"

# ImageKit credentials (if applicable)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Google OAuth Client ID (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=""

# Transactional Email (Resend: https://resend.com)
# Leave blank for local development (will log OTP & Link to terminal console)
RESEND_API_KEY=""
EMAIL_FROM="WeTravel <onboarding@resend.dev>"
APP_BASE_URL="https://wetravel.app"
