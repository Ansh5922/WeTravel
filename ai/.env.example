# Database connection string (e.g. Neon PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Environment
ENVIRONMENT="development"

# Shared JWT secret with Node.js backend
JWT_SECRET="your-super-secret-jwt-key"
JWT_ALGORITHM="HS256"

# Optional: Custom path to Tesseract OCR binary (auto-detected if on PATH or default Windows install)
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
